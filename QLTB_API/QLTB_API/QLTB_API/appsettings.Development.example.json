{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "ForwardLimit": 1,
    "KnownProxies": []
  },
  "Jwt": {
    "Issuer": "QLTB",
    "Audience": "QLTB",
    "Key": "REPLACE_WITH_A_LONG_LOCAL_JWT_SECRET"
  },
  "JwtSettings": {
    "Secret": "REPLACE_WITH_A_LONG_LOCAL_JWT_SECRET"
  },
  "ConnectionStrings": {
    "QLTB": "User Id=QLTB;Password=REPLACE_WITH_LOCAL_PASSWORD;Data Source=REPLACE_WITH_ORACLE_SERVICE"
  },
  "FTP": {
    "Server": "ftp://localhost",
    "Username": "local-user",
    "Password": "REPLACE_WITH_LOCAL_PASSWORD"
  },
  "AES": {
    "AES_KEY": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="
  },
  "SSO": {
    "SharedSecret": "REPLACE_WITH_LOCAL_SSO_SECRET"
  },
  "Cors": {
    "Origins": [ "http://localhost:3000" ]
  },
  "ApiBaseUrl": "https://localhost:5001",
  "SignatureApi": {
    "RootUrl": "http://localhost:8080"
  },
  "URI_SEVER": "https://localhost:5001"
}
